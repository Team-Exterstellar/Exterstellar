{
  "manifest_version": 3,
  "name": "Exterstellar",
  "version": "1.0.3",
  "description": "Exterstellar is a QoL-focused browser extension for Stardance.",
  "icons": {
    "16": "images/16.png",
    "48": "images/48.png",
    "128": "images/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Exterstellar"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://*.stardance.hackclub.com/*"],
      "js": [
        "plugins/registry.js",
        "plugins/better-sidebar.js",
        "plugins/better-goi.js",
        "plugins/custom-font.js",
        "plugins/scrollbar.js",
        "plugins/oneko.js",
        "plugins/devlog-formatter.js",
        "plugins/sidebar-hotkeys.js",
        "plugins/sidebar-reorder.js",
        "plugins/themes.js",
        "plugins/md-preview.js",
        "plugins/devlog-changelog.js",
        "plugins/shop-goals-enhanced.js",
        "plugins/persistent-devlogs.js",
        "plugins/rng-odds.js",
        "plugins/focus-mode.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage", "scripting", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://gitlab.com/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["importer.html", "importer.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "exterstellar@extension",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
